	<properties>
		<maven.compiler.release>21</maven.compiler.release>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>


		<spring.boot.version>3.5.7</spring.boot.version>
		<okhttp3.version>5.2.1</okhttp3.version>
		<aspectjweaver.version>1.9.22.1</aspectjweaver.version>
		<selenium.version>4.38.0</selenium.version>


		<maven.compiler.plugin.version>3.14.1</maven.compiler.plugin.version>
		<maven.checkstyle.plugin.version>3.6.0</maven.checkstyle.plugin.version>
		<jacoco.maven.plugin.version>0.8.14</jacoco.maven.plugin.version>
		<maven.enforcer.plugin.version>3.6.2</maven.enforcer.plugin.version>
		<maven.surefire.plugin.version>3.5.4</maven.surefire.plugin.version>
		<maven.surefire.report.plugin.version>3.5.4</maven.surefire.report.plugin.version>
		<maven.failsafe.plugin.version>3.5.4</maven.failsafe.plugin.version>
		<maven.site.plugin.version>3.21.0</maven.site.plugin.version>
		<maven.project.info.reports.plugin.version>3.9.0</maven.project.info.reports.plugin.version>
		<!-- maven.cucumber 5.8.4 has issues. do not use it -->
		<maven.cucumber.reporting.plugin.version>5.9.0</maven.cucumber.reporting.plugin.version>
		<cluecumber.maven.plugin.version>3.11.2</cluecumber.maven.plugin.version>
		<allure.maven.plugin.version>2.16.1</allure.maven.plugin.version>
	</properties>


	<distributionManagement>
		<site>
			<id>mcck-site</id>
			<name>mcck site</name>
			<url>https://dummy-site/a/b/c</url>
		</site>
	</distributionManagement>


	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.carthageking.mc</groupId>
				<artifactId>mcck-core-allure-cucumber7-jvm</artifactId>
				<version>1.0.0</version>
			</dependency>

			<dependency>
				<groupId>org.carthageking.mc</groupId>
				<artifactId>mcck-core-checkstyle</artifactId>
				<version>1.0.0</version>
			</dependency>

			<dependency>
				<groupId>org.carthageking.mc</groupId>
				<artifactId>mcck-core-csv</artifactId>
				<version>1.0.0</version>
			</dependency>

			<dependency>
				<groupId>org.carthageking.mc</groupId>
				<artifactId>mcck-core-cucumber</artifactId>
				<version>1.0.0</version>
			</dependency>

			<dependency>
				<groupId>org.carthageking.mc</groupId>
				<artifactId>mcck-core-httpclient</artifactId>
				<version>1.0.0</version>
			</dependency>

			<dependency>
				<groupId>org.carthageking.mc</groupId>
				<artifactId>mcck-core-httpclient-apache-httpclient4</artifactId>
